# =============================================================================
# Clinica Off Road — variables de entorno
# NO subir al repo (.gitignore ya lo ignora). En Vercel: Project > Settings >
# Environment Variables.
# =============================================================================
#
#  QUE VA Y DE DONDE SALE
#  ----------------------
#  VITE_FIREBASE_*      Firebase console > Project settings > General > "Your
#                       apps" > Web app > SDK setup. Son claves publicas.
#  VITE_ADMIN_EMAILS    Email(s) del panel admin, separados por coma. Tiene que
#                       coincidir con los que authorize firestore.rules y
#                       storage.rules (si lo dejas vacio solo manda las reglas).
#  FIREBASE_*           Service Account (Project settings > Service accounts).
#                       Secretos: solo los usan los scripts locales (npm run
#                       seed / check:firebase). La app NO los necesita.
#
# =============================================================================

# ---------- Frontend (publicas) ----------

VITE_FIREBASE_API_KEY=PENDING
VITE_FIREBASE_AUTH_DOMAIN=PENDING.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PENDING
VITE_FIREBASE_STORAGE_BUCKET=PENDING.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=PENDING
VITE_FIREBASE_APP_ID=PENDING

# ---------- Panel admin ----------

VITE_ADMIN_EMAILS=PENDING

# ---------- Solo scripts locales (secretos, no hacen falta en Vercel) ----------

FIREBASE_PROJECT_ID=PENDING
FIREBASE_CLIENT_EMAIL=PENDING
FIREBASE_PRIVATE_KEY=PENDING