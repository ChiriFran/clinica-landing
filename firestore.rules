rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- AGREGAR ACÁ LOS ADMINS (se autentican con Firebase Auth) ----
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@gmail.com'];
    }

    function validRegistration() {
      let d = request.resource.data;
      return d.receipt is string
        && d.status == 'pendiente'
        && d.createdAt is string
        && d.persona.nombre is string && d.persona.nombre.size() >= 2 && d.persona.nombre.size() <= 80
        && d.persona.apellido is string && d.persona.apellido.size() >= 2 && d.persona.apellido.size() <= 80
        && d.persona.email is string && d.persona.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && d.persona.whatsapp is string && d.persona.whatsapp.size() >= 10
        && d.persona.experiencia is string && d.persona.experiencia.size() > 0
        && d.moto.cilindradaRango is string && d.moto.cilindradaRango.size() > 0
        && d.final.aceptaTerminos == true;
    }

    // Contenido de la landing: lectura publica, escritura solo de admins.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inscripciones: cualquiera puede crear una (validada), solo los admins
    // pueden leerlas, cambiarlas o borrarlas.
    // El id se deriva del email, asi que un segundo intento de inscripcion con
    // el mismo email choca con las reglas (no se pueden duplicar).
    match /registrations/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || validRegistration();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}